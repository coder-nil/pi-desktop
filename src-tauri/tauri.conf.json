{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Desktop",
  "version": "0.84.2-aphla.1",
  "identifier": "com.agegr.pi-desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../desktop-dist/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
